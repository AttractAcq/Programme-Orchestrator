{
  "schema_version": 1,
  "programme": {
    "id": "cockpit-complete-build",
    "name": "Cockpit Complete Build Programme",
    "baseline_commit": "7d4c1b9",
    "target_repository": {
      "full_name": "AttractAcq/Cockpit",
      "remote": "origin"
    },
    "sequence": [
      "phase-1",
      "phase-1b",
      "phase-2a",
      "phase-2b"
    ]
  },
  "defaults": {
    "git": {
      "base_branch": "main",
      "branch_prefix": "orchestrator",
      "integration_branch": "programme/cockpit-complete-build",
      "auto_commit": true,
      "auto_push": false,
      "push_integration_branch": false,
      "cleanup_worktree_on_success": false
    },
    "agent": {
      "provider": "codex-exec",
      "sandbox": "workspace-write",
      "timeout_ms": 7200000
    },
    "execution": {
      "max_concurrent_runs": 1,
      "claim_lease_ms": 300000
    },
    "verification": {
      "commands": [
        {
          "command": "npm",
          "args": [
            "run",
            "typecheck"
          ]
        },
        {
          "command": "npm",
          "args": [
            "run",
            "lint"
          ]
        },
        {
          "command": "npm",
          "args": [
            "test"
          ]
        },
        {
          "command": "npm",
          "args": [
            "run",
            "build"
          ]
        },
        {
          "command": "git",
          "args": [
            "diff",
            "--check"
          ]
        }
      ],
      "verifier_agent": {
        "enabled": true,
        "sandbox": "read-only"
      }
    }
  },
